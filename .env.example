# PostgreSQL / Neon
DATABASE_URL=

# Production distributed rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional database pool tuning
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000

# Optional error monitoring (Sentry). The app runs fine with these unset —
# Sentry.init() is skipped entirely when no DSN is present.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed in CI/production builds that upload source maps to Sentry.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Private portfolio admin dashboard
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
